<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="hosny_pos_home.HomeScreen">
        <div class="hh-home" dir="rtl">
            <div class="hh-stage">
                <div class="hh-brand">
                    <span class="hh-brand-icon"><i class="fa fa-cutlery" aria-hidden="true"/></span>
                    <strong>مطعم حسني</strong>
                </div>

                <section class="hh-panel">
                    <!-- الوقت | نقطة البيع | مزامنة السيرفر -->
                    <div class="hh-info">
                        <div class="hh-box hh-box-clock">
                            <h2 class="hh-box-title"><i class="fa fa-clock-o" aria-hidden="true"/> الوقت والتاريخ</h2>
                            <div class="hh-clock" t-att-title="hijri">
                                <span class="hh-clock-time"><t t-esc="time.hm"/><span class="hh-clock-sec">:<t t-esc="time.s"/></span></span>
                                <span class="hh-clock-date" t-esc="date"/>
                            </div>
                        </div>
                        <div class="hh-box hh-box-branch">
                            <h2 class="hh-box-title"><i class="fa fa-map-marker" aria-hidden="true"/> نقطة البيع</h2>
                            <div class="hh-branch">
                                <div class="hh-branch-copy">
                                    <span><b>الفرع:</b> <t t-esc="pos.config.name"/></span>
                                    <span><b>معلومات الفرع:</b> <t t-esc="branchAddress"/></span>
                                </div>
                                <div class="hh-branch-logo"><img t-att-src="logo" alt=""/></div>
                            </div>
                        </div>
                        <div class="hh-box hh-box-sync">
                            <h2 class="hh-box-title">
                                <i class="fa fa-refresh" aria-hidden="true"/> مزامنة السيرفر
                                <span t-attf-class="hh-net {{ online ? 'is-online' : 'is-offline' }}"
                                      t-esc="online ? 'متصل' : 'غير متصل'"/>
                            </h2>
                            <div class="hh-sync">
                                <span><b>اسم المستخدم:</b> <t t-esc="cashierName"/></span>
                                <span><b>آخر مزامنة:</b> <bdi t-esc="syncedAt"/></span>
                                <span><b>الوردية:</b> <bdi t-esc="pos.session.name"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- الأزرار -->
                    <div class="hh-tiles">
                        <button t-foreach="tiles" t-as="tile" t-key="tile.key"
                                t-attf-class="hh-tile hh-tone-{{ tile.tone }}"
                                t-on-click="() => tile.run()">
                            <span class="hh-tile-badge" t-if="tile.badge" t-esc="tile.badge"/>
                            <span class="hh-tile-icon"><i t-attf-class="fa {{ tile.icon }}" aria-hidden="true"/></span>
                            <span class="hh-tile-title" t-esc="tile.title"/>
                        </button>
                    </div>
                </section>

                <footer class="hh-foot">
                    <span t-if="state.failed" class="hh-foot-warn">تعذّرت المزامنة — تُعرض آخر بيانات</span>
                    <span t-elif="!online" class="hh-foot-warn">غير متصل — الطلبات تُحفظ على الجهاز وتُرسل عند عودة الاتصال</span>
                    <span t-else="">مطعم حسني — نقطة البيع · فرع <t t-esc="branch"/></span>
                </footer>
            </div>
        </div>
    </t>

    <t t-name="hosny_pos_home.ShiftReport">
        <Dialog title="'تقرير الوردية'" contentClass="'hh-report'" size="'lg'">
            <div class="hh-report-body" dir="rtl">
                <div class="hh-report-kpis">
                    <div><span>مبيعات اليوم</span><b t-esc="fmt(props.summary.today_total)"/></div>
                    <div><span>طلبات اليوم</span><b t-esc="props.summary.today_count || 0"/></div>
                    <div><span>مبيعات الوردية</span><b t-esc="fmt(props.summary.session_total)"/></div>
                    <div><span>طلبات الوردية</span><b t-esc="props.summary.session_count || 0"/></div>
                </div>
                <div class="hh-report-cols">
                    <div>
                        <h4>طرق الدفع اليوم</h4>
                        <table class="hh-report-table">
                            <tr t-foreach="props.summary.payments || []" t-as="p" t-key="p.name">
                                <td t-esc="p.name"/><td class="num" t-esc="fmt(p.amount)"/>
                            </tr>
                            <tr t-if="!(props.summary.payments || []).length"><td colspan="2" class="hh-muted">لا مدفوعات بعد</td></tr>
                        </table>
                    </div>
                    <div>
                        <h4>الأكثر مبيعاً اليوم</h4>
                        <table class="hh-report-table">
                            <tr t-foreach="props.summary.top_products || []" t-as="p" t-key="p_index">
                                <td t-esc="p.name"/><td class="num" t-esc="qty(p.qty)"/><td class="num" t-esc="fmt(p.amount)"/>
                            </tr>
                            <tr t-if="!(props.summary.top_products || []).length"><td colspan="3" class="hh-muted">لا أصناف بعد</td></tr>
                        </table>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button t-if="canPrint" class="btn btn-primary btn-lg" t-on-click="print">
                    <i class="fa fa-print" aria-hidden="true"/> طباعة تقرير الوردية
                </button>
                <button class="btn btn-secondary btn-lg" t-on-click="props.close">إغلاق</button>
            </t>
        </Dialog>
    </t>

    <!-- نوع الطاولة لألوان شاشة الطاولات (سفري وردي في أي دور) -->
    <t t-name="hosny_pos_home.FloorScreen" t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('floor-table')]" position="attributes">
            <attribute name="t-att-data-hh-kind">hosnyTableKind(table)</attribute>
        </xpath>
    </t>

    <!-- زر «الرئيسية» في الشريط العلوي -->
    <t t-name="hosny_pos_home.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'pos-rightheader')]" position="inside">
            <button t-if="hosnyShowHomeButton" class="hh-nav-home" title="الشاشة الرئيسية"
                    t-on-click="() => this.pos.hosnyGoHome()">
                <i class="fa fa-th-large" aria-hidden="true"/>
                <span>الرئيسية</span>
            </button>
            <span t-if="hosnyTableChip" class="hh-nav-table" dir="rtl" title="طاولة الطلب">
                <i class="fa fa-cutlery" aria-hidden="true"/>
                <span>طاولة <bdi class="hh-nav-table-num" t-esc="hosnyTableChip.number"/></span>
                <span t-if="hosnyTableChip.floor" class="hh-nav-table-floor" t-esc="hosnyTableChip.floor"/>
            </span>
        </xpath>
    </t>
</templates>
