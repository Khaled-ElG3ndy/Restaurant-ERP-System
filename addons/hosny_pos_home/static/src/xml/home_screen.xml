<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="hosny_pos_home.HomeScreen">
        <div class="hh-home" dir="rtl">
            <div class="hh-stage">
                <div class="hh-brand">
                    <span class="hh-brand-icon"><i class="fa fa-cutlery" aria-hidden="true"/></span>
                    <strong>مطعم حسني</strong>
                </div>

                <section class="hh-panel">
                    <!-- الوقت | نقطة البيع | مزامنة السيرفر -->
                    <div class="hh-info">
                        <div class="hh-box hh-box-clock">
                            <h2 class="hh-box-title"><i class="fa fa-clock-o" aria-hidden="true"/> الوقت والتاريخ</h2>
                            <div class="hh-clock" t-att-title="hijri">
                                <span class="hh-clock-time"><t t-esc="time.hm"/><span class="hh-clock-sec">:<t t-esc="time.s"/></span></span>
                                <span class="hh-clock-date" t-esc="date"/>
                            </div>
                        </div>
                        <div class="hh-box hh-box-branch">
                            <h2 class="hh-box-title"><i class="fa fa-map-marker" aria-hidden="true"/> نقطة البيع</h2>
                            <div class="hh-branch">
                                <div class="hh-branch-copy">
                                    <span><b>الفرع:</b> <t t-esc="pos.config.name"/></span>
                                    <span><b>معلومات الفرع:</b> <t t-esc="branchAddress"/></span>
                                </div>
                                <div class="hh-branch-logo"><img t-att-src="logo" alt=""/></div>
                            </div>
                        </div>
                        <div class="hh-box hh-box-sync">
                            <h2 class="hh-box-title">
                                <i class="fa fa-refresh" aria-hidden="true"/> مزامنة السيرفر
                                <span t-attf-class="hh-net {{ online ? 'is-online' : 'is-offline' }}"
                                      t-esc="online ? 'متصل' : 'غير متصل'"/>
                            </h2>
                            <div class="hh-sync">
                                <span><b>اسم المستخدم:</b> <t t-esc="cashierName"/></span>
                                <span><b>آخر مزامنة:</b> <bdi t-esc="syncedAt"/></span>
                                <span><b>الوردية:</b> <bdi t-esc="pos.session.name"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- الأزرار -->
                    <div class="hh-tiles">
                        <button t-foreach="tiles" t-as="tile" t-key="tile.key"
                                t-attf-class="hh-tile hh-tone-{{ tile.tone }}"
                                t-on-click="() => tile.run()">
                            <span class="hh-tile-badge" t-if="tile.badge" t-esc="tile.badge"/>
                            <span class="hh-tile-icon"><i t-attf-class="fa {{ tile.icon }}" aria-hidden="true"/></span>
                            <span class="hh-tile-title" t-esc="tile.title"/>
                        </button>
                    </div>
                </section>

                <footer class="hh-foot">
                    <span t-if="state.failed" class="hh-foot-warn">تعذّرت المزامنة — تُعرض آخر بيانات</span>
                    <span t-elif="!online" class="hh-foot-warn">غير متصل — الطلبات تُحفظ على الجهاز وتُرسل عند عودة الاتصال</span>
                    <span t-else="">مطعم حسني — نقطة البيع · فرع <t t-esc="branch"/></span>
                </footer>
            </div>
        </div>
    </t>

    <t t-name="hosny_pos_home.ShiftReport">
        <Dialog title="'تقرير الوردية'" contentClass="'hh-report'" size="'xl'">
            <div class="hh-report-body" dir="rtl">
                <div t-if="state.loading and !state.data" class="hh-report-state">
                    <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/> جارٍ تحميل أرقام الوردية…
                </div>
                <t t-if="state.data">
                    <div class="hh-report-meta">
                        <span><small>الوردية</small><b><bdi t-esc="d.session_name"/></b></span>
                        <span><small>بدأت</small><b><bdi t-esc="d.session_start"/></b></span>
                        <span><small>المدة</small><b><bdi t-esc="d.duration"/> ساعة</b></span>
                        <span><small>فتحها</small><b t-esc="d.session_user"/></span>
                    </div>

                    <div class="hh-report-kpis">
                        <div class="is-main">
                            <span>صافي مبيعات الوردية</span>
                            <b t-esc="fmt(d.total)"/>
                        </div>
                        <div>
                            <span>عدد الطلبات</span>
                            <b t-esc="d.count"/>
                        </div>
                        <div>
                            <span>متوسط الطلب</span>
                            <b t-esc="fmt(d.average)"/>
                        </div>
                        <div t-att-class="{ 'is-red': d.refund_count }">
                            <span>المرتجعات <t t-if="d.refund_count">(<t t-esc="d.refund_count"/>)</t></span>
                            <b t-esc="fmt(d.refund_total)"/>
                        </div>
                    </div>

                    <div class="hh-report-chips">
                        <span><i class="fa fa-percent" aria-hidden="true"/> الخصومات <b t-esc="fmt(d.discount_total)"/></span>
                        <span><i class="fa fa-motorcycle" aria-hidden="true"/> الخدمة والتوصيل <b t-esc="fmt(d.fees_total)"/></span>
                        <span t-att-class="{ 'is-amber': d.open_count }"><i class="fa fa-hourglass-half" aria-hidden="true"/> طلبات مفتوحة <b><t t-esc="d.open_count"/> · <t t-esc="fmt(d.open_total)"/></b></span>
                        <span><i class="fa fa-calendar" aria-hidden="true"/> مبيعات اليوم (كل الورديات) <b t-esc="fmt(d.today_total)"/></span>
                    </div>

                    <div class="hh-report-cols">
                        <section class="hh-report-card">
                            <h4><i class="fa fa-credit-card" aria-hidden="true"/> طرق الدفع في الوردية</h4>
                            <table class="hh-report-table">
                                <thead><tr><th>الطريقة</th><th class="num">طلبات</th><th class="num">المبلغ</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="d.payments || []" t-as="p" t-key="p_index">
                                        <td t-esc="p.name"/><td class="num" t-esc="p.count"/><td class="num" t-esc="fmt(p.amount)"/>
                                    </tr>
                                    <tr t-if="!(d.payments || []).length"><td colspan="3" class="hh-muted">لا مدفوعات في هذه الوردية</td></tr>
                                </tbody>
                                <tfoot t-if="(d.payments || []).length">
                                    <tr><td>الإجمالي</td><td/><td class="num" t-esc="fmt(d.payments_total)"/></tr>
                                </tfoot>
                            </table>

                            <div t-if="d.cash and d.cash.name" class="hh-report-cash">
                                <h4><i class="fa fa-money" aria-hidden="true"/> النقد في الدرج</h4>
                                <div><span>رصيد الافتتاح</span><b t-esc="fmt(d.cash.opening)"/></div>
                                <div><span>مدفوعات <t t-esc="d.cash.name"/></span><b t-esc="fmt(d.cash.payments)"/></div>
                                <div><span>الإيداع / السحب</span><b t-esc="fmt(d.cash.moves)"/></div>
                                <div class="is-total"><span>المتوقع في الدرج</span><b t-esc="fmt(d.cash.expected)"/></div>
                            </div>
                        </section>
                        <section class="hh-report-card">
                            <h4><i class="fa fa-star" aria-hidden="true"/> الأكثر مبيعاً في الوردية</h4>
                            <table class="hh-report-table">
                                <thead><tr><th>#</th><th>الصنف</th><th class="num">الكمية</th><th class="num">المبلغ</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="d.top_products || []" t-as="p" t-key="p_index">
                                        <td class="rank" t-esc="p_index + 1"/>
                                        <td class="name" t-esc="p.name"/>
                                        <td class="num" t-esc="qty(p.qty)"/>
                                        <td class="num" t-esc="fmt(p.amount)"/>
                                    </tr>
                                    <tr t-if="!(d.top_products || []).length"><td colspan="4" class="hh-muted">لا أصناف في هذه الوردية</td></tr>
                                </tbody>
                            </table>
                        </section>
                    </div>
                </t>
                <div t-if="state.error" class="hh-report-error" role="alert">
                    <i class="fa fa-exclamation-circle" aria-hidden="true"/> <t t-esc="state.error"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <div class="hh-report-foot">
                    <button t-if="canPrint" class="btn btn-primary btn-lg hh-report-print" t-att-disabled="state.printing or !state.data" t-on-click="print">
                        <i t-attf-class="fa {{ state.printing ? 'fa-circle-o-notch fa-spin' : 'fa-print' }}" aria-hidden="true"/> طباعة تقرير الوردية
                    </button>
                    <button class="btn btn-secondary btn-lg hh-report-refresh" t-att-disabled="state.loading" t-on-click="() => this.load()">
                        <i t-attf-class="fa fa-refresh {{ state.loading ? 'fa-spin' : '' }}" aria-hidden="true"/> تحديث
                    </button>
                    <span t-if="d.printed_at" class="hh-report-stamp">حتى <bdi t-esc="d.printed_at"/></span>
                    <button class="btn btn-secondary btn-lg hh-report-close" t-on-click="props.close">إغلاق</button>
                </div>
            </t>
        </Dialog>
    </t>

    <!-- نوع الطاولة لألوان شاشة الطاولات (سفري وردي في أي دور) -->
    <t t-name="hosny_pos_home.FloorScreen" t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('floor-table')]" position="attributes">
            <attribute name="t-att-data-hh-kind">hosnyTableKind(table)</attribute>
        </xpath>
    </t>

    <!-- زر «الرئيسية» في الشريط العلوي -->
    <t t-name="hosny_pos_home.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'pos-rightheader')]" position="inside">
            <button t-if="hosnyShowHomeButton" class="hh-nav-home" title="الشاشة الرئيسية"
                    t-on-click="() => this.pos.hosnyGoHome()">
                <i class="fa fa-th-large" aria-hidden="true"/>
                <span>الرئيسية</span>
            </button>
            <span t-if="hosnyTableChip" class="hh-nav-table" dir="rtl" title="طاولة الطلب">
                <i class="fa fa-cutlery" aria-hidden="true"/>
                <span>طاولة <bdi class="hh-nav-table-num" t-esc="hosnyTableChip.number"/></span>
                <span t-if="hosnyTableChip.floor" class="hh-nav-table-floor" t-esc="hosnyTableChip.floor"/>
            </span>
        </xpath>
    </t>
</templates>
