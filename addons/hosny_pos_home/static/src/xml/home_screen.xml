<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="hosny_pos_home.HomeScreen">
        <div class="hh-home" dir="rtl">
            <!-- الرأس: الساعة والشعار | الكاشير والوردية | اسم المطعم -->
            <header class="hh-head">
                <div class="hh-head-clock">
                    <div class="hh-crest"><img t-att-src="logo" alt="مطعم حسني"/></div>
                    <div class="hh-clock">
                        <div class="hh-time">
                            <span class="hh-time-hm" t-esc="time.hm"/>
                            <span class="hh-time-ampm" t-esc="time.ampm"/>
                        </div>
                        <div class="hh-date" t-att-title="hijri">
                            <i class="fa fa-calendar-o" aria-hidden="true"/>
                            <span><t t-esc="weekday"/> <t t-esc="gregorian"/></span>
                        </div>
                    </div>
                </div>
                <div class="hh-head-mid">
                    <div class="hh-cashier">
                        <span class="hh-avatar" t-esc="cashierInitial"/>
                        <div class="hh-cashier-copy">
                            <span class="hh-cashier-role" t-esc="cashierRole"/>
                            <strong class="hh-cashier-name" t-esc="cashierName"/>
                        </div>
                    </div>
                    <div class="hh-shift" t-att-title="shift.name">
                        <span class="hh-shift-icon"><i class="fa fa-clock-o" aria-hidden="true"/></span>
                        <div class="hh-shift-copy">
                            <span t-attf-class="hh-shift-state {{ online ? 'is-online' : 'is-offline' }}">
                                <t t-esc="online ? 'الوردية الحالية' : 'غير متصل — الطلبات تُحفظ على الجهاز'"/>
                            </span>
                            <strong t-esc="shift.label"/>
                            <span class="hh-shift-time" t-if="shift.startText">
                                بدأت <t t-esc="shift.startText"/> · منذ <t t-esc="shift.since"/>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="hh-brand">
                    <div class="hh-brand-copy">
                        <strong>مطعم حسني</strong>
                        <span>نقطة البيع · فرع <t t-esc="branch"/></span>
                    </div>
                    <span class="hh-brand-icon"><i class="fa fa-cutlery" aria-hidden="true"/></span>
                </div>
            </header>

            <div class="hh-body">
                <!-- آخر الطلبات -->
                <aside class="hh-recent">
                    <h2 class="hh-recent-title">آخر الطلبات</h2>
                    <ul class="hh-orders" t-if="recentOrders.length">
                        <li t-foreach="recentOrders" t-as="o" t-key="o.key">
                            <span class="hh-order-amount" t-esc="fmt(o.amount)"/>
                            <span class="hh-order-place" t-esc="o.place"/>
                            <span class="hh-order-ref">#<t t-esc="o.ref"/></span>
                            <span t-attf-class="hh-order-state is-{{ o.tone }}" t-esc="o.state"/>
                            <span class="hh-order-time" t-esc="o.time"/>
                        </li>
                    </ul>
                    <div class="hh-empty" t-else="">
                        <t t-esc="state.loading ? 'جارٍ التحميل…' : 'لا طلبات اليوم بعد'"/>
                    </div>
                    <button class="hh-recent-all" t-on-click="() => pos.navigate('TicketScreen')">
                        عرض جميع الطلبات <i class="fa fa-arrow-right" aria-hidden="true"/>
                    </button>
                </aside>

                <main class="hh-main">
                    <!-- نظرة سريعة على اليوم -->
                    <section class="hh-glance">
                        <h2 class="hh-glance-title">نظرة سريعة على اليوم</h2>
                        <div class="hh-kpis">
                            <div class="hh-kpi">
                                <div class="hh-kpi-copy">
                                    <span class="hh-kpi-label">إجمالي المبيعات</span>
                                    <span class="hh-kpi-value" t-esc="state.loading ? '…' : fmt(summary.today_total)"/>
                                </div>
                                <span class="hh-kpi-icon is-mint"><i class="fa fa-bar-chart" aria-hidden="true"/></span>
                                <div class="hh-kpi-foot">
                                    <div class="hh-spark" t-if="hours.length" role="img" aria-label="المبيعات بالساعة اليوم">
                                        <span t-foreach="hours" t-as="b" t-key="b.h"
                                              t-attf-class="hh-spark-bar {{ b.now ? 'is-now' : '' }}"
                                              t-attf-style="block-size: {{ b.pct }}%" t-att-title="b.tip"/>
                                    </div>
                                    <span t-if="delta" t-attf-class="hh-delta {{ delta.up ? 'is-up' : 'is-down' }}"
                                          title="مقارنة بأمس حتى نفس الساعة">
                                        <bdi><t t-esc="delta.up ? '+' : '-'"/><t t-esc="delta.pct"/>%</bdi>
                                        <i t-attf-class="fa {{ delta.up ? 'fa-arrow-up' : 'fa-arrow-down' }}" aria-hidden="true"/>
                                    </span>
                                    <span t-elif="!state.loading" class="hh-kpi-note">
                                        <b t-esc="summary.today_count || 0"/> طلب اليوم
                                    </span>
                                </div>
                            </div>

                            <div class="hh-kpi">
                                <div class="hh-kpi-copy">
                                    <span class="hh-kpi-label">الطاولات المشغولة</span>
                                    <span class="hh-kpi-value"><bdi dir="ltr"><t t-esc="tables.busy"/> / <t t-esc="tables.total"/></bdi></span>
                                </div>
                                <span class="hh-kpi-icon is-teal"><i class="fa fa-cutlery" aria-hidden="true"/></span>
                                <div class="hh-kpi-foot">
                                    <div class="hh-meter" role="img" t-attf-aria-label="{{ tables.busy }} من {{ tables.total }}">
                                        <div class="hh-meter-fill" t-attf-style="inline-size: {{ tables.pct }}%"/>
                                    </div>
                                </div>
                            </div>

                            <div class="hh-kpi">
                                <div class="hh-kpi-copy">
                                    <span class="hh-kpi-label">الطلبات المفتوحة</span>
                                    <span class="hh-kpi-value" t-esc="openOrders.length"/>
                                </div>
                                <span class="hh-kpi-icon is-violet"><i class="fa fa-file-text-o" aria-hidden="true"/></span>
                                <div class="hh-kpi-foot"><span class="hh-kpi-note">طلب قيد التنفيذ</span></div>
                            </div>

                            <div class="hh-kpi hh-kpi-pay" t-att-title="paymentsDetail">
                                <div class="hh-kpi-copy">
                                    <span class="hh-kpi-label">طرق الدفع</span>
                                </div>
                                <span class="hh-kpi-icon is-blue"><i class="fa fa-credit-card" aria-hidden="true"/></span>
                                <ul class="hh-pay" t-if="payments.length">
                                    <li t-foreach="payments.slice(0, 2)" t-as="p" t-key="p.name">
                                        <span t-esc="p.name"/>
                                        <b t-esc="fmt(p.amount)"/>
                                    </li>
                                </ul>
                                <div class="hh-kpi-foot" t-else="">
                                    <span class="hh-kpi-note" t-esc="state.loading ? '…' : 'لا مدفوعات بعد'"/>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- الاختصارات الرئيسية -->
                    <section class="hh-tiles-main">
                        <t t-foreach="mainTiles" t-as="tile" t-key="tile.key">
                            <t t-call="hosny_pos_home.Tile"/>
                        </t>
                    </section>
                    <section class="hh-tiles-more">
                        <t t-foreach="moreTiles" t-as="tile" t-key="tile.key">
                            <t t-call="hosny_pos_home.Tile"/>
                        </t>
                    </section>

                    <section class="hh-banner">
                        <span class="hh-banner-icon"><i class="fa fa-smile-o" aria-hidden="true"/></span>
                        <div class="hh-banner-copy">
                            <strong>معاً لرضا ضيوفنا</strong>
                            <span><t t-esc="greeting"/>، <t t-esc="cashierName"/> — خدمة أسرع .. وتجربة أمتع</span>
                        </div>
                        <span class="hh-banner-warn" t-if="state.failed">تعذّر تحديث الأرقام — تُعرض آخر قيم</span>
                        <div class="hh-banner-art" aria-hidden="true"><img t-att-src="logo" alt=""/></div>
                    </section>
                </main>

                <!-- القائمة الجانبية -->
                <nav class="hh-nav" aria-label="القائمة">
                    <t t-foreach="navItems" t-as="item" t-key="item.key">
                        <button t-attf-class="hh-nav-item {{ item.active ? 'is-active' : '' }}"
                                t-att-aria-current="item.active ? 'page' : false"
                                t-on-click="() => item.run()">
                            <span class="hh-nav-label">
                                <t t-esc="item.title"/>
                                <span class="hh-nav-badge" t-if="item.badge" t-esc="item.badge"/>
                            </span>
                            <span class="hh-nav-icon"><i t-attf-class="fa {{ item.icon }}" aria-hidden="true"/></span>
                        </button>
                    </t>
                    <div class="hh-nav-foot">
                        <div class="hh-nav-art" aria-hidden="true"><img t-att-src="logo" alt=""/></div>
                        <span class="hh-nav-motto">أكل طيّب .. مزاج أطيب</span>
                        <button t-if="isManager" class="hh-nav-item hh-nav-settings" t-on-click="() => pos.closePos()">
                            <span class="hh-nav-label">لوحة التحكم</span>
                            <span class="hh-nav-icon"><i class="fa fa-cog" aria-hidden="true"/></span>
                        </button>
                    </div>
                </nav>
            </div>
        </div>
    </t>

    <t t-name="hosny_pos_home.Tile">
        <button t-attf-class="hh-tile hh-tone-{{ tile.tone }} hh-tile-{{ tile.key }}" t-on-click="() => tile.run()">
            <span class="hh-tile-deco" aria-hidden="true"><i t-attf-class="fa {{ tile.icon }}"/></span>
            <span class="hh-tile-icon">
                <i t-attf-class="fa {{ tile.icon }}" aria-hidden="true"/>
                <span class="hh-tile-badge" t-if="tile.badge" t-esc="tile.badge"/>
            </span>
            <span class="hh-tile-copy">
                <span class="hh-tile-title" t-esc="tile.title"/>
                <span class="hh-tile-sub" t-esc="tile.sub"/>
            </span>
            <span class="hh-tile-go" aria-hidden="true"><i class="fa fa-arrow-right"/></span>
        </button>
    </t>

    <t t-name="hosny_pos_home.ShiftReport">
        <Dialog title="'تقرير الوردية'" contentClass="'hh-report'" size="'lg'">
            <div class="hh-report-body" dir="rtl">
                <div class="hh-report-kpis">
                    <div><span>مبيعات اليوم</span><b t-esc="fmt(props.summary.today_total)"/></div>
                    <div><span>طلبات اليوم</span><b t-esc="props.summary.today_count || 0"/></div>
                    <div><span>مبيعات الوردية</span><b t-esc="fmt(props.summary.session_total)"/></div>
                    <div><span>طلبات الوردية</span><b t-esc="props.summary.session_count || 0"/></div>
                </div>
                <div class="hh-report-cols">
                    <div>
                        <h4>طرق الدفع اليوم</h4>
                        <table class="hh-report-table">
                            <tr t-foreach="props.summary.payments || []" t-as="p" t-key="p.name">
                                <td t-esc="p.name"/><td class="num" t-esc="fmt(p.amount)"/>
                            </tr>
                            <tr t-if="!(props.summary.payments || []).length"><td colspan="2" class="hh-muted">لا مدفوعات بعد</td></tr>
                        </table>
                    </div>
                    <div>
                        <h4>الأكثر مبيعاً اليوم</h4>
                        <table class="hh-report-table">
                            <tr t-foreach="props.summary.top_products || []" t-as="p" t-key="p_index">
                                <td t-esc="p.name"/><td class="num" t-esc="qty(p.qty)"/><td class="num" t-esc="fmt(p.amount)"/>
                            </tr>
                            <tr t-if="!(props.summary.top_products || []).length"><td colspan="3" class="hh-muted">لا أصناف بعد</td></tr>
                        </table>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button t-if="canPrint" class="btn btn-primary btn-lg" t-on-click="print">
                    <i class="fa fa-print" aria-hidden="true"/> طباعة تقرير الوردية
                </button>
                <button class="btn btn-secondary btn-lg" t-on-click="props.close">إغلاق</button>
            </t>
        </Dialog>
    </t>

    <!-- زر «الرئيسية» في الشريط العلوي -->
    <t t-name="hosny_pos_home.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'pos-rightheader')]" position="inside">
            <button t-if="hosnyShowHomeButton" class="hh-nav-home" title="الشاشة الرئيسية"
                    t-on-click="() => this.pos.hosnyGoHome()">
                <i class="fa fa-th-large" aria-hidden="true"/>
                <span>الرئيسية</span>
            </button>
        </xpath>
    </t>
</templates>
