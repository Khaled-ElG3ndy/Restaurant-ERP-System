<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_ui_clean.NewInvoiceButton"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//button[hasclass('more-btn')]" position="before">
        <button t-if="!props.showRemainingButtons"
                t-att-class="buttonClass"
                class="control-button btn btn-light rounded-0 fw-bolder"
                t-on-click="() => this.goToWorkplaceSelector()">
            <i class="fa fa-file-text-o me-1"/>
            <span>فاتورة جديدة</span>
        </button>
        </xpath>
    </t>
</templates>
