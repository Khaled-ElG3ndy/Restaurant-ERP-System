<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_modern_ui.ProductScreenNumpadToggle"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'actionpad')]" position="inside">
            <button class="button btn btn-light toggle-numpad-btn"
                    t-on-click="() => this.toggleNumpad()">
                <i class="fa fa-calculator me-1"/>
                <span>Numpad</span>
            </button>
        </xpath>

    </t>

</templates>