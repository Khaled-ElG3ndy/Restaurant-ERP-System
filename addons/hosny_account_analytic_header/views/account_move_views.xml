<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_analytic_header" model="ir.ui.view">
        <field name="name">account.move.form.analytic.header</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']/div[field[@name='partner_id']]" position="after">
                <field name="analytic_account_id"
                       string="الحساب التحليلي"
                       domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       options="{'no_create': True}"
                       required="move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or (move_type == 'entry' and not origin_payment_id and not statement_line_id)"
                       readonly="state != 'draft'"
                       invisible="move_type not in ('entry', 'out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or (move_type == 'entry' and (origin_payment_id or statement_line_id))"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='analytic_distribution']" position="replace">
                <field name="analytic_distribution" invisible="1" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='analytic_distribution']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='analytic_distribution']" position="replace">
                <field name="analytic_distribution" invisible="1" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/form//field[@name='analytic_distribution']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
