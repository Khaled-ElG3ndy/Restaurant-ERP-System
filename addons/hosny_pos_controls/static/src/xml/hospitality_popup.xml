<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="hosny_pos_controls.HospitalityPopup">
        <Dialog size="'xl'" contentClass="'hosny-hospitality-dialog'">
            <t t-set-slot="header" t-slot-scope="scope">
                <div class="hosny-hospitality-title">
                    <span>الضيافة</span>
                    <span class="hosny-hospitality-title-icon" aria-hidden="true">
                        <svg viewBox="0 0 72 72">
                            <defs>
                                <linearGradient id="hosnyClocheGold" x1="0" y1="0" x2="1" y2="1">
                                    <stop offset="0" stop-color="#f6d77a"/>
                                    <stop offset="0.55" stop-color="#d3a32f"/>
                                    <stop offset="1" stop-color="#9b6c09"/>
                                </linearGradient>
                            </defs>
                            <path d="M48 15c4-5 10-2 9 3-.5 2.5-2.4 4-5.2 4" fill="none" stroke="#e7c461" stroke-width="3" stroke-linecap="round"/>
                            <path d="M53 10c3-3 7-.8 6.5 2.8" fill="none" stroke="#ead17f" stroke-width="2.4" stroke-linecap="round"/>
                            <circle cx="34" cy="13" r="5" fill="url(#hosnyClocheGold)"/>
                            <path d="M12 48c1.8-18 10-29 22-29s20.2 11 22 29H12z" fill="url(#hosnyClocheGold)"/>
                            <path d="M8 49h52c2 0 3.5 1.5 3.5 3.5S62 56 60 56H8c-2 0-3.5-1.5-3.5-3.5S6 49 8 49z" fill="url(#hosnyClocheGold)"/>
                            <path d="M17 59h34" fill="none" stroke="#9b6c09" stroke-width="4" stroke-linecap="round"/>
                            <path d="M18 43c2-11 7.7-18 16-20" fill="none" stroke="#fff2b6" stroke-width="3" stroke-linecap="round" opacity=".75"/>
                        </svg>
                    </span>
                </div>
                
            </t>
            <div class="hosny-hospitality-content" dir="rtl">
                <div t-if="!hospitalityProducts.length" class="hosny-hospitality-empty">
                    <span class="hosny-hospitality-empty-icon">
                        <svg viewBox="0 0 64 64" aria-hidden="true">
                            <circle cx="32" cy="8" r="4"/>
                            <path d="M13 32c1.8-12.4 9.2-20 19-20s17.2 7.6 19 20H13z"/>
                            <path d="M7 34h50v5H7z"/>
                            <path d="M8.5 48.5c6.2-3.5 12.2-3.8 18-.9l9 4.5c1.7.8 3.5.2 4.3-1.3l.4-.8-8.8-4.1 2.1-4.2 9.6 4.5c1.4.7 2.5 1.8 3.1 3.1l5-3c5.3-3.2 10.2 4 5.2 7.6L41 64H21.5L6 54.5l2.5-6z"/>
                        </svg>
                    </span>
                    <strong>No hospitality products are enabled for this branch</strong>
                </div>
                <div t-elif="!filteredProducts.length" class="hosny-hospitality-empty">
                    <i class="fa fa-search" aria-hidden="true"/>
                    <strong>No matching products</strong>
                </div>
                <div t-else="" class="hosny-hospitality-grid">
                    <button t-foreach="filteredProducts"
                            t-as="product"
                            t-key="product.id"
                            type="button"
                            class="hosny-hospitality-card"
                            t-att-class="isSelected(product) ? 'is-selected' : ''"
                            t-att-aria-pressed="isSelected(product) ? 'true' : 'false'"
                            t-on-click="() => this.toggleProduct(product)">
                        <span class="hosny-hospitality-check">
                            <i t-att-class="isSelected(product) ? 'fa fa-check' : ''" aria-hidden="true"/>
                        </span>
                        <span class="hosny-hospitality-image-wrap">
                            <img t-if="pos.config.show_product_images"
                                 t-att-src="product.getImageUrl()"
                                 class="hosny-hospitality-image"
                                 alt="Product image"/>
                            <span t-else="" class="hosny-hospitality-image hosny-hospitality-image-placeholder">
                                <svg viewBox="0 0 64 64" aria-hidden="true">
                                    <circle cx="32" cy="8" r="4"/>
                                    <path d="M13 32c1.8-12.4 9.2-20 19-20s17.2 7.6 19 20H13z"/>
                                    <path d="M7 34h50v5H7z"/>
                                </svg>
                            </span>
                            <span class="hosny-hospitality-image-badge">
                                <i class="fa fa-leaf" aria-hidden="true"/> ضيافة
                            </span>
                        </span>
                        <span class="hosny-hospitality-card-body">
                            <span class="hosny-hospitality-product-name" t-esc="product.display_name || product.name"/>
                            <span class="hosny-hospitality-original-price">
                                <span>السعر الضيافي</span>
                                <b t-esc="formattedOriginalPrice(product)"/>
                            </span>
                        </span>
                    </button>
                </div>
            </div>

            <t t-set-slot="footer">
                <div class="hosny-hospitality-footer" dir="rtl">
                    <button type="button" class="btn btn-primary btn-lg hosny-hospitality-add" t-on-click="addSelected" t-att-disabled="!selectedCount || state.adding">
                        <span>إضافة المختار</span>
                        <i class="fa fa-plus" aria-hidden="true"/>
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-lg" t-on-click="selectAll" t-att-disabled="!filteredProducts.length">
                        <i class="fa fa-check-square-o" aria-hidden="true"/> اختيار الكل
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-lg" t-on-click="clearSelection" t-att-disabled="!selectedCount">
                        إلغاء اختيار الكل <i class="fa fa-square-o" aria-hidden="true"/>
                    </button>
                    <button type="button" class="btn btn-secondary btn-lg hosny-hospitality-cancel" t-on-click="props.close">إلغاء</button>
                </div>
            </t>
        </Dialog>
    </t>
</templates>
