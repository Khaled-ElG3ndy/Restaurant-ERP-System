<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- «تسديد الفواتير» بتقسيمة FERP: الفلاتر فوق، والجدول تحتها -->
    <t t-name="hosny_pos_payment.InvoicesScreen">
        <div class="hi-screen" dir="rtl">
            <header class="hi-head">
                <h1><i class="fa fa-file-text-o" aria-hidden="true"/> تسديد الفواتير</h1>
                <button class="hi-back" t-on-click="() => this.back()">
                    <i class="fa fa-arrow-right" aria-hidden="true"/> رجوع
                </button>
            </header>

            <!-- الفلاتر -->
            <form class="hi-card hi-filters" t-on-submit.prevent="() => this.invSearch()">
                <label class="hi-field">
                    <span>من تاريخ</span>
                    <div class="hi-input"><i class="fa fa-calendar" aria-hidden="true"/>
                        <input type="datetime-local" t-model="inv.filters.dateFrom"/></div>
                </label>
                <label class="hi-field">
                    <span>إلى تاريخ</span>
                    <div class="hi-input"><i class="fa fa-calendar" aria-hidden="true"/>
                        <input type="datetime-local" t-model="inv.filters.dateTo"/></div>
                </label>
                <label class="hi-field">
                    <span>نوع الفاتورة</span>
                    <div class="hi-input"><i class="fa fa-tags" aria-hidden="true"/>
                        <select t-model="inv.filters.orderTypeId">
                            <option value="">الكل</option>
                            <option t-foreach="inv.types" t-as="type" t-key="type.id" t-att-value="type.id" t-esc="type.name"/>
                        </select></div>
                </label>
                <label class="hi-field">
                    <span>رقم الفاتورة</span>
                    <div class="hi-input"><i class="fa fa-hashtag" aria-hidden="true"/>
                        <input type="search" inputmode="numeric" placeholder="رقم الفاتورة أو المرجع" t-model="inv.filters.number"/></div>
                </label>
                <label class="hi-field">
                    <span>تسديد الفواتير</span>
                    <div class="hi-input"><i class="fa fa-money" aria-hidden="true"/>
                        <select t-model="inv.filters.status">
                            <option value="all">الكل</option>
                            <option value="paid">مدفوعة</option>
                            <option value="open">غير مدفوعة</option>
                            <option value="pay_later">أجل</option>
                            <option value="refund">مرتجع</option>
                        </select></div>
                </label>
                <label class="hi-field">
                    <span>الطاولات</span>
                    <div class="hi-input"><i class="fa fa-cutlery" aria-hidden="true"/>
                        <select t-model="inv.filters.tableId">
                            <option value="">الكل</option>
                            <option t-foreach="inv.tables" t-as="table" t-key="table.id" t-att-value="table.id" t-esc="table.name"/>
                        </select></div>
                </label>
                <div class="hi-filter-actions">
                    <button type="submit" class="hi-btn is-search" t-att-disabled="inv.loading">
                        <i t-attf-class="fa {{ inv.loading ? 'fa-circle-o-notch fa-spin' : 'fa-search' }}" aria-hidden="true"/> بحث
                    </button>
                    <button type="button" class="hi-btn is-reset" t-on-click="() => this.invReset()">
                        <i class="fa fa-eraser" aria-hidden="true"/> إلغاء الفلتر
                    </button>
                </div>
            </form>

            <!-- الجدول -->
            <section class="hi-card hi-grid">
                <div class="hi-table-wrap" t-ref="invWrap">
                    <table class="hi-table">
                        <thead>
                            <tr>
                                <th t-on-click="() => this.invSortBy('date')">التاريخ <i t-attf-class="fa {{ invSortIcon('date') }}"/></th>
                                <th class="hi-col-time">الوقت</th>
                                <th t-on-click="() => this.invSortBy('number')">رقم الفاتورة <i t-attf-class="fa {{ invSortIcon('number') }}"/></th>
                                <th t-on-click="() => this.invSortBy('type')">النوع <i t-attf-class="fa {{ invSortIcon('type') }}"/></th>
                                <th t-on-click="() => this.invSortBy('status')">الدفع <i t-attf-class="fa {{ invSortIcon('status') }}"/></th>
                                <th class="is-num" t-on-click="() => this.invSortBy('amount')">الصافي <i t-attf-class="fa {{ invSortIcon('amount') }}"/></th>
                                <th class="is-center">مرتجع</th>
                                <th t-on-click="() => this.invSortBy('partner')">العميل <i t-attf-class="fa {{ invSortIcon('partner') }}"/></th>
                                <th class="hi-col-phone">رقم الهاتف</th>
                                <th class="is-center" t-on-click="() => this.invSortBy('prints')">عدد مرات الطباعة <i t-attf-class="fa {{ invSortIcon('prints') }}"/></th>
                                <th class="is-ops">العمليات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="invPageRows" t-as="row" t-key="row.id" t-att-class="{ 'is-busy': inv.busyId === row.id }">
                                <td class="is-num"><bdi t-esc="invDate(row)"/><bdi class="hi-date-time" t-esc="invTime(row)"/></td>
                                <td class="is-num is-muted hi-col-time"><bdi t-esc="invTime(row)"/></td>
                                <td class="is-num is-strong" t-att-title="row.reference"><bdi t-esc="row.number"/></td>
                                <td t-esc="invPlace(row)"/>
                                <td><span t-attf-class="hi-chip is-{{ invStatus(row).tone }}" t-esc="invStatus(row).label"/></td>
                                <td class="is-num is-strong" t-esc="invMoney(row.amount)"/>
                                <td class="is-center">
                                    <i t-if="row.refunded" class="fa fa-undo hi-refunded" title="تم إرجاع أصناف منها"/>
                                    <span t-else="" class="is-muted">—</span>
                                </td>
                                <td class="is-clip"><t t-esc="row.partner or '—'"/><bdi t-if="row.phone" class="hi-partner-phone" t-esc="row.phone"/></td>
                                <td class="is-num is-muted hi-col-phone"><bdi t-esc="row.phone or '—'"/></td>
                                <td class="is-center is-num" t-esc="row.prints"/>
                                <td class="is-ops">
                                    <div class="hi-ops">
                                    <button t-if="row.status === 'open'" class="hi-op is-pay" t-on-click="() => this.invPay(row)">
                                        <i class="fa fa-money" aria-hidden="true"/> تسديد
                                    </button>
                                    <button class="hi-op is-print" title="طباعة فورية" t-on-click="() => this.invPrint(row)">
                                        <i class="fa fa-print" aria-hidden="true"/> <span class="hi-op-text">طباعة فورية</span>
                                    </button>
                                    <button class="hi-op is-view" title="عرض" t-on-click="() => this.invView(row)">
                                        <i class="fa fa-eye" aria-hidden="true"/> <span class="hi-op-text">عرض</span>
                                    </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div t-if="!inv.rows.length" class="hi-empty">
                        <i t-attf-class="fa {{ inv.loading ? 'fa-circle-o-notch fa-spin' : 'fa-inbox' }}" aria-hidden="true"/>
                        <t t-esc="inv.loading ? 'جارٍ جلب الفواتير…' : 'لا توجد فواتير بهذه الفلاتر'"/>
                    </div>
                </div>
                <footer class="hi-pager">
                    <div class="hi-stats">
                        <span t-if="inv.rows.length" class="hi-pager-info">
                            عرض <b><t t-esc="invPageRange.start"/>–<t t-esc="invPageRange.end"/></b> من <b t-esc="invPageRange.total"/>
                        </span>
                        <span>الإجمالي <b t-esc="invMoney(invTotals.amount)"/></span>
                        <span t-if="invTotals.open" class="is-open"><b t-esc="invTotals.open"/> غير مدفوعة</span>
                        <span t-if="inv.totalCount > inv.rows.length" class="is-warn">
                            محمّل <t t-esc="inv.rows.length"/> من <t t-esc="inv.totalCount"/> — ضيّق الفلتر
                        </span>
                        <button class="hi-excel" t-att-disabled="!inv.rows.length" t-on-click="() => this.invExport()" title="تصدير إلى Excel">
                            <i class="fa fa-file-excel-o" aria-hidden="true"/> Excel
                        </button>
                    </div>
                    <div class="hi-pager-nav" t-if="invPageCount > 1">
                        <button class="hi-page is-arrow" t-att-disabled="inv.page === 1" t-on-click="() => this.invGoPage(inv.page - 1)" title="السابق">
                            <i class="fa fa-chevron-right" aria-hidden="true"/> السابق
                        </button>
                        <t t-foreach="invPageButtons" t-as="btn" t-key="btn.key">
                            <span t-if="btn.gap" class="hi-page-gap">…</span>
                            <button t-else="" class="hi-page" t-att-class="{ 'is-current': btn.page === inv.page }"
                                    t-on-click="() => this.invGoPage(btn.page)" t-esc="btn.page"/>
                        </t>
                        <button class="hi-page is-arrow" t-att-disabled="inv.page === invPageCount" t-on-click="() => this.invGoPage(inv.page + 1)" title="التالي">
                            التالي <i class="fa fa-chevron-left" aria-hidden="true"/>
                        </button>
                    </div>
                </footer>
            </section>
        </div>
    </t>
</templates>
