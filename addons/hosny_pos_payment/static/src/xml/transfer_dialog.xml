<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- «نقل الطلبات»: الأصناف ثم الطاولة -->
    <t t-name="hosny_pos_payment.TransferDialog">
        <Dialog title="'نقل الطلبات'" size="'xl'" contentClass="'hx-dialog'" bodyClass="'hx-body'">
            <div class="hx" dir="rtl">

                <!-- الخطوات -->
                <div class="hx-steps">
                    <span class="hx-from"><i class="fa fa-cutlery" aria-hidden="true"/> من <b t-esc="sourceTitle"/></span>
                    <div class="hx-stepper">
                        <button class="hx-step" t-att-class="{ 'is-on': state.step === 1, 'is-done': state.step === 2 }" t-on-click="back">
                            <span class="hx-step-num"><t t-if="state.step === 2"><i class="fa fa-check" aria-hidden="true"/></t><t t-else="">1</t></span>
                            اختيار الأصناف
                        </button>
                        <i class="fa fa-angle-left hx-step-sep" aria-hidden="true"/>
                        <button class="hx-step" t-att-class="{ 'is-on': state.step === 2 }" t-on-click="next">
                            <span class="hx-step-num">2</span>
                            اختيار الطاولة
                        </button>
                    </div>
                    <span t-if="anySelected" class="hx-mode" t-att-class="isFullTransfer ? 'is-full' : 'is-part'">
                        <t t-esc="isFullTransfer ? 'تحويل كلي' : 'تحويل جزئي'"/>
                    </span>
                </div>

                <!-- ١) الأصناف -->
                <section t-if="state.step === 1" class="hx-card hx-items">
                    <div class="hx-head">
                        <span class="is-check">
                            <button class="hx-check" t-att-class="{ 'is-on': allFull, 'is-mixed': anySelected and !allFull }"
                                    t-att-title="allFull ? 'إلغاء تحديد الكل' : 'تحديد الكل'" t-on-click="toggleAll">
                                <i t-attf-class="fa {{ allFull ? 'fa-check' : (anySelected ? 'fa-minus' : '') }}" aria-hidden="true"/>
                            </button>
                        </span>
                        <span>الاسم</span>
                        <span class="is-center">الكمية</span>
                        <span class="is-center">الكمية للنقل</span>
                    </div>
                    <div class="hx-list">
                        <div t-foreach="lines" t-as="line" t-key="line.uuid" class="hx-row"
                             t-att-class="{ 'is-on': selQty(line) > 0, 'is-part': selQty(line) > 0 and !isFull(line) }">
                            <span class="is-check">
                                <button class="hx-check" t-att-class="{ 'is-on': isFull(line), 'is-mixed': selQty(line) > 0 and !isFull(line) }"
                                        t-on-click="() => this.toggleLine(line)">
                                    <i t-attf-class="fa {{ isFull(line) ? 'fa-check' : (selQty(line) > 0 ? 'fa-minus' : '') }}" aria-hidden="true"/>
                                </button>
                            </span>
                            <span class="hx-name" t-on-click="() => this.toggleLine(line)">
                                <b t-esc="lineName(line)"/>
                                <small>
                                    <t t-if="line.combo_line_ids?.length">وجبة · </t>
                                    <t t-esc="money(line.priceIncl / line.qty)"/> للوحدة
                                    <t t-if="line.note"> · <t t-esc="line.note"/></t>
                                </small>
                            </span>
                            <span class="hx-qty"><bdi t-esc="qtyText(line.qty)"/></span>
                            <span class="hx-stepper-qty">
                                <button class="hx-pm is-minus" t-att-disabled="selQty(line) &lt;= 0" t-on-click="() => this.stepQty(line, -1)" aria-label="أقل">
                                    <i class="fa fa-minus" aria-hidden="true"/>
                                </button>
                                <input type="text" inputmode="decimal" class="hx-qty-input"
                                       t-att-value="selQty(line) ? qtyText(selQty(line)) : ''" placeholder="0"
                                       t-on-input="(ev) => this.typeQty(line, ev)" t-on-focus="(ev) => ev.target.select()"/>
                                <button class="hx-pm is-plus" t-att-disabled="isFull(line)" t-on-click="() => this.stepQty(line, 1)" aria-label="أكثر">
                                    <i class="fa fa-plus" aria-hidden="true"/>
                                </button>
                            </span>
                        </div>
                    </div>
                    <div class="hx-sum">
                        <t t-if="anySelected">
                            <span>محدد <b t-esc="summary.items"/> من <b t-esc="lines.length"/></span>
                            <span>الكمية <b><bdi t-esc="qtyText(summary.pieces)"/></b></span>
                            <span>القيمة <b t-esc="money(summary.amount)"/></span>
                        </t>
                        <span t-else="" class="hx-sum-hint">
                            علّم على الكل للتحويل الكلي، أو اختر بعض الأصناف وحدد الكمية للتحويل الجزئي
                        </span>
                    </div>
                </section>

                <!-- ٢) الطاولة -->
                <section t-else="" class="hx-card hx-tables">
                    <div class="hx-floors">
                        <button t-foreach="floors" t-as="floor" t-key="floor.id" class="hx-floor"
                                t-att-class="{ 'is-on': floor.id === state.floorId }" t-on-click="() => this.pickFloor(floor)">
                            <span t-esc="floor.name"/>
                            <small t-if="floorBusyCount(floor)"><t t-esc="floorBusyCount(floor)"/> مشغولة</small>
                        </button>
                    </div>
                    <div class="hx-grid">
                        <button t-foreach="floorTables" t-as="table" t-key="table.id" class="hx-table"
                                t-att-class="{
                                    'is-busy': tableOrders(table).length,
                                    'is-source': isSource(table),
                                    'is-picked': table.id === state.tableId,
                                }"
                                t-att-disabled="isSource(table)"
                                t-on-click="() => this.pickTable(table)" t-on-dblclick="() => this.pickAndGo(table)">
                            <b t-esc="tableLabel(table)"/>
                            <small t-if="isSource(table)">الحالية</small>
                            <small t-elif="tableOrders(table).length" t-esc="money(tableAmount(table))"/>
                            <small t-else="">فارغة</small>
                        </button>
                        <div t-if="!floorTables.length" class="hx-empty">لا توجد طاولات في هذا الدور</div>
                    </div>
                    <div class="hx-sum" t-att-class="{ 'is-merge': pickedTable and tableOrders(pickedTable).length }">
                        <t t-if="pickedTable">
                            <i t-attf-class="fa {{ tableOrders(pickedTable).length ? 'fa-object-group' : 'fa-arrow-left' }}" aria-hidden="true"/>
                            <span>
                                <t t-esc="isFullTransfer ? 'نقل الطلب كاملاً' : ('نقل ' + itemsText(summary.items))"/>
                                إلى <b>طاولة <t t-esc="tableLabel(pickedTable)"/></b>
                                <t t-if="tableOrders(pickedTable).length"> — الطاولة مشغولة وستُضاف الأصناف إلى طلبها</t>
                            </span>
                        </t>
                        <span t-else="" class="hx-sum-hint">اختر الطاولة التي تريد النقل إليها</span>
                    </div>
                </section>

                <div t-if="state.error" class="hx-error">
                    <i class="fa fa-exclamation-circle" aria-hidden="true"/> <t t-esc="state.error"/>
                </div>
            </div>

            <t t-set-slot="footer">
                <div class="hx-footer">
                    <button t-if="state.step === 1" class="hx-btn is-ok" t-att-disabled="!anySelected" t-on-click="next">
                        موافق <i class="fa fa-arrow-left" aria-hidden="true"/>
                    </button>
                    <t t-else="">
                        <button class="hx-btn is-ok" t-att-disabled="!pickedTable or state.busy" t-on-click="confirm">
                            <i t-attf-class="fa {{ state.busy ? 'fa-circle-o-notch fa-spin' : 'fa-check-circle' }}" aria-hidden="true"/>
                            <t t-if="pickedTable">نقل إلى طاولة <t t-esc="tableLabel(pickedTable)"/></t>
                            <t t-else="">تأكيد النقل</t>
                        </button>
                        <button class="hx-btn is-back" t-on-click="back">
                            <i class="fa fa-arrow-right" aria-hidden="true"/> رجوع للأصناف
                        </button>
                    </t>
                    <button class="hx-btn is-close" t-on-click="props.close">إغلاق</button>
                </div>
            </t>
        </Dialog>
    </t>

    <!-- «تحويل» معطّل للسفري وللطلب الفارغ (الزر من hosny_pos_controls) -->
    <t t-name="hosny_pos_payment.TransferButtonState" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('hosny-transfer-button')]" position="attributes">
            <attribute name="t-att-disabled">!hpCanTransfer</attribute>
            <attribute name="t-att-title">hpCanTransfer ? 'نقل الأصناف إلى طاولة أخرى' : 'التحويل لطلبات الطاولات فقط'</attribute>
        </xpath>
    </t>
</templates>
