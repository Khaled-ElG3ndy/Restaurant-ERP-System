<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_hosny_coupon_prefix" model="ir.ui.view">
        <field name="name">pos.config.form.hosny.coupon.prefix</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']/div[hasclass('o_settings_container')]" position="inside">
                <setting string="كود الفرع في الكوبونات" help="أول رقمين في أرقام كوبونات الخصم التي يبيعها هذا الفرع.">
                    <field name="hosny_coupon_prefix" placeholder="20"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
