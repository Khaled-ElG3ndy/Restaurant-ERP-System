<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loyalty_card_list_hosny" model="ir.ui.view">
        <field name="name">loyalty.card.list.hosny</field>
        <field name="model">loyalty.card</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="كوبونات الخصم" create="0" delete="0">
                <field name="hosny_code_display"/>
                <field name="partner_id"/>
                <field name="hosny_issue_id"/>
                <field name="hosny_initial_value" sum="1"/>
                <field name="hosny_used_value" sum="1"/>
                <field name="points" string="المتبقي" sum="1"/>
                <field name="expiration_date"/>
                <field name="hosny_status" widget="badge" decoration-success="hosny_status == 'active'" decoration-muted="hosny_status in ('used', 'cancelled')" decoration-danger="hosny_status == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_loyalty_card_search_hosny" model="ir.ui.view">
        <field name="name">loyalty.card.search.hosny</field>
        <field name="model">loyalty.card</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="hosny_issue_id"/>
                <filter name="with_balance" string="لها رصيد" domain="[('points', '>', 0)]"/>
                <filter name="expired" string="منتهية برصيد" domain="[('points', '>', 0), ('expiration_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_partner" string="العميل" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_issue" string="الإصدار" context="{'group_by': 'hosny_issue_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hosny_coupon_cards" model="ir.actions.act_window">
        <field name="name">الكوبونات المصدرة</field>
        <field name="res_model">loyalty.card</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('hosny_issue_id', '!=', False)]</field>
        <field name="context">{'search_default_with_balance': 1}</field>
        <field name="search_view_id" ref="view_loyalty_card_search_hosny"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_loyalty_card_list_hosny')})]"/>
    </record>
</odoo>
