<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- تقرير الإغلاق على شاشة الوردية -->
    <record id="view_pos_session_form_hosny_close" model="ir.ui.view">
        <field name="name">pos.session.form.hosny.close</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <notebook invisible="state != 'closed'">
                    <page string="تقرير الإغلاق" name="hosny_close_report">
                        <group>
                            <group string="الوردية">
                                <field name="hosny_order_count"/>
                                <field name="hosny_sales_total"/>
                                <field name="hosny_refund_total"/>
                                <field name="hosny_refund_count"/>
                            </group>
                            <group string="النقدية">
                                <field name="hosny_cash_counted"/>
                                <field name="hosny_cash_difference"/>
                                <field name="hosny_handover_amount"/>
                                <field name="hosny_handover_line_id" groups="account.group_account_readonly"/>
                            </group>
                            <group string="الأجل">
                                <field name="hosny_paylater_expected"/>
                                <field name="hosny_paylater_counted"/>
                                <field name="hosny_paylater_difference"/>
                            </group>
                            <group string="الخصومات والكوبونات والضيافة">
                                <field name="hosny_discount_total"/>
                                <field name="hosny_coupon_total"/>
                                <field name="hosny_coupon_count"/>
                                <field name="hosny_hospitality_total"/>
                                <field name="hosny_hospitality_count"/>
                                <field name="hosny_giftcard_total" invisible="not hosny_giftcard_total"/>
                                <field name="hosny_giftcard_count" invisible="not hosny_giftcard_count"/>
                                <field name="hosny_void_total"/>
                                <field name="hosny_void_count"/>
                            </group>
                        </group>
                        <field name="hosny_method_line_ids">
                            <list>
                                <field name="payment_method_id"/>
                                <field name="method_type"/>
                                <field name="payment_count"/>
                                <field name="expected" sum="المتوقع"/>
                                <field name="counted"/>
                                <field name="difference" sum="الفرق" decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- «تقارير الورديات»: الورديات المغلقة جنباً إلى جنب للمقارنة -->
    <record id="view_pos_session_list_hosny_report" model="ir.ui.view">
        <field name="name">pos.session.list.hosny.report</field>
        <field name="model">pos.session</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="تقارير الورديات" create="0" delete="0">
                <field name="name"/>
                <field name="config_id"/>
                <field name="user_id" optional="show"/>
                <field name="start_at" optional="hide"/>
                <field name="stop_at"/>
                <field name="hosny_order_count" sum="1"/>
                <field name="hosny_sales_total" sum="1"/>
                <field name="hosny_cash_counted" sum="1"/>
                <field name="hosny_cash_difference" sum="1" decoration-danger="hosny_cash_difference &lt; 0" decoration-success="hosny_cash_difference &gt; 0"/>
                <field name="hosny_handover_amount" sum="1" optional="show"/>
                <field name="hosny_paylater_expected" sum="1"/>
                <field name="hosny_paylater_counted" sum="1" optional="show"/>
                <field name="hosny_paylater_difference" sum="1" optional="show" decoration-danger="hosny_paylater_difference != 0"/>
                <field name="hosny_discount_total" sum="1"/>
                <field name="hosny_hospitality_total" sum="1"/>
                <field name="hosny_coupon_total" sum="1"/>
                <field name="hosny_giftcard_total" sum="1" optional="hide"/>
                <field name="hosny_refund_total" sum="1" optional="show"/>
                <field name="hosny_void_total" sum="1" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pos_session_pivot_hosny_report" model="ir.ui.view">
        <field name="name">pos.session.pivot.hosny.report</field>
        <field name="model">pos.session</field>
        <field name="arch" type="xml">
            <pivot string="تقارير الورديات">
                <field name="config_id" type="row"/>
                <field name="stop_at" interval="day" type="col"/>
                <field name="hosny_sales_total" type="measure"/>
                <field name="hosny_cash_difference" type="measure"/>
                <field name="hosny_paylater_expected" type="measure"/>
                <field name="hosny_discount_total" type="measure"/>
                <field name="hosny_hospitality_total" type="measure"/>
                <field name="hosny_coupon_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hosny_shift_method_line_pivot" model="ir.ui.view">
        <field name="name">hosny.shift.method.line.pivot</field>
        <field name="model">hosny.shift.method.line</field>
        <field name="arch" type="xml">
            <pivot string="طرق الدفع في الورديات">
                <field name="config_id" type="row"/>
                <field name="payment_method_id" type="col"/>
                <field name="expected" type="measure"/>
                <field name="counted" type="measure"/>
                <field name="difference" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hosny_shift_method_line_list" model="ir.ui.view">
        <field name="name">hosny.shift.method.line.list</field>
        <field name="model">hosny.shift.method.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="session_id"/>
                <field name="config_id"/>
                <field name="stop_at"/>
                <field name="payment_method_id"/>
                <field name="payment_count" sum="1"/>
                <field name="expected" sum="1"/>
                <field name="counted" sum="1"/>
                <field name="difference" sum="1" decoration-danger="difference &lt; 0" decoration-success="difference &gt; 0"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_hosny_shift_reports" model="ir.actions.act_window">
        <field name="name">تقارير الورديات</field>
        <field name="res_model">pos.session</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('state', '=', 'closed')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_pos_session_list_hosny_report')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_pos_session_pivot_hosny_report')})]"/>
    </record>

    <record id="action_hosny_shift_method_lines" model="ir.actions.act_window">
        <field name="name">طرق الدفع في الورديات</field>
        <field name="res_model">hosny.shift.method.line</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <menuitem id="menu_hosny_shift_reports" name="تقارير الورديات" parent="point_of_sale.menu_point_rep"
              action="action_hosny_shift_reports" sequence="5" groups="point_of_sale.group_pos_manager"/>
    <menuitem id="menu_hosny_shift_method_lines" name="طرق الدفع في الورديات" parent="point_of_sale.menu_point_rep"
              action="action_hosny_shift_method_lines" sequence="6" groups="point_of_sale.group_pos_manager"/>
</odoo>
