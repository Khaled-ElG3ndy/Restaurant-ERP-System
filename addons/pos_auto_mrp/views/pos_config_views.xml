<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_auto_mrp" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.auto.mrp</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Auto Manufacturing">
                    <group>
                        <field name="auto_create_mrp_from_pos"/>
                        <field name="auto_done_mrp_from_pos"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>