<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_mrp_source_profile_list_view" model="ir.ui.view">
        <field name="name">pos.mrp.source.profile.list</field>
        <field name="model">pos.mrp.source.profile</field>
        <field name="arch" type="xml">
            <list string="POS Component Sources" decoration-success="ready_for_all_pos" decoration-warning="not ready_for_all_pos">
                <header>
                    <button name="action_sync_from_locations" type="object" string="Synchronize Leaf Locations" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="route_count" string="Configured Points of Sale"/>
                <field name="ready_for_all_pos" widget="boolean_toggle" readonly="1"/>
                <field name="missing_pos_names" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="pos_mrp_source_profile_form_view" model="ir.ui.view">
        <field name="name">pos.mrp.source.profile.form</field>
        <field name="model">pos.mrp.source.profile</field>
        <field name="arch" type="xml">
            <form string="POS Component Source">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. مخزن قسم الشواية"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <div class="alert alert-success" role="alert" invisible="not ready_for_all_pos">
                        This source is configured for every active manufacturing Point of Sale.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="ready_for_all_pos">
                        Missing Point of Sale routes: <field name="missing_pos_names" class="oe_inline" readonly="1"/>
                    </div>
                    <group string="Automatic Branch Routing">
                        <field name="route_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="pos_config_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="location_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_mrp_source_profile_search_view" model="ir.ui.view">
        <field name="name">pos.mrp.source.profile.search</field>
        <field name="model">pos.mrp.source.profile</field>
        <field name="arch" type="xml">
            <search string="POS Component Sources">
                <field name="name"/>
                <filter name="ready" string="Ready" domain="[('ready_for_all_pos', '=', True)]"/>
                <filter name="incomplete" string="Needs Configuration" domain="[('ready_for_all_pos', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pos_mrp_source_profile" model="ir.actions.act_window">
        <field name="name">POS Component Sources</field>
        <field name="res_model">pos.mrp.source.profile</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pos_mrp_source_profile_search_view"/>
        <field name="context">{'search_default_ready': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Synchronize branch leaf locations</p>
            <p>Each Arabic logical name routes automatically to one physical location per Point of Sale.</p>
        </field>
    </record>

    <menuitem id="menu_pos_mrp_source_profile"
              name="Component Source Locations"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_mrp_source_profile"
              sequence="30"
              groups="point_of_sale.group_pos_manager"/>
</odoo>
