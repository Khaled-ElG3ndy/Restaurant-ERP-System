<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_mo_link" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.mo.link</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="before">
                <field name="mrp_production_count" invisible="1"/>
                <field name="mrp_unbuild_count" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mrp_productions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="mrp_production_count == 0">
                    <field name="mrp_production_count" widget="statinfo" string="Manufacturing"/>
                </button>
                <button name="action_view_mrp_unbuilds"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-undo"
                        invisible="mrp_unbuild_count == 0">
                    <field name="mrp_unbuild_count" widget="statinfo" string="Unbuilds"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='lines']/list/field[@name='full_product_name']" position="after">
                <field name="mrp_production_count" column_invisible="True"/>
                <field name="mrp_unbuild_count" column_invisible="True"/>
                <field name="mrp_production_id"
                       string="Manufacturing Order"
                       readonly="1"
                       widget="pos_mrp_production_internal_link"/>

                <field name="mrp_unbuild_id" string="Unbuild Order" readonly="1"/>

                <button name="action_open_mrp_unbuild"
                        type="object"
                        string="Open Unbuild"
                        class="btn-link"
                        invisible="mrp_unbuild_count == 0"/>
                <field name="manufactured_qty" optional="hide" readonly="1"/>
                <field name="returned_qty" optional="show" readonly="1"/>
                <field name="unbuilt_qty" optional="show" readonly="1"/>
                <field name="remaining_returnable_qty" optional="show" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='lines']/form/group/field[@name='full_product_name']" position="after">
                <field name="mrp_production_id"
                       string="Manufacturing Order"
                       readonly="1"
                       widget="pos_mrp_production_internal_link"/>
                <field name="mrp_production_count" invisible="1"/>
                <field name="mrp_unbuild_count" invisible="1"/>

                <field name="mrp_unbuild_id" string="Unbuild Order" readonly="1"/>

                <button name="action_open_mrp_unbuild"
                        type="object"
                        string="Open Unbuild"
                        class="oe_link"
                        invisible="mrp_unbuild_count == 0"/>
                <field name="manufactured_qty" readonly="1"/>
                <field name="returned_qty" readonly="1"/>
                <field name="unbuilt_qty" readonly="1"/>
                <field name="remaining_returnable_qty" readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>
