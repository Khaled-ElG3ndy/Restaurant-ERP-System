<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hosny_pos_meal_combo.PosAdditionalCostField">
        <span class="o_pos_additional_cost_cell d-inline-flex align-items-center">
            <span class="o_pos_additional_cost_value" t-esc="value"/>
            <button t-if="hasDetails"
                    type="button"
                    class="btn btn-link btn-sm p-0 o_pos_additional_cost_info"
                    t-att-title="detailsTitle"
                    t-att-aria-label="detailsTitle"
                    t-on-click.stop.prevent="openDetails">
                <i class="fa fa-info-circle" aria-hidden="true"/>
            </button>
        </span>
    </t>

    <t t-name="hosny_pos_meal_combo.PosProductInternalLink">
        <a t-if="product"
           class="o_form_uri o_pos_product_internal_link text-truncate d-inline-block w-100"
           t-att-href="productHref"
           t-att-title="productName"
           t-on-click.stop.prevent="openProduct"
           t-esc="productName"/>
        <span t-else="">—</span>
    </t>
</templates>
