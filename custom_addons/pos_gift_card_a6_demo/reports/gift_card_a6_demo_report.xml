<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_gift_card_a6_landscape_demo" model="report.paperformat">
            <field name="name">Hosny A6 Discount Coupon Demo</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <!-- wkhtmltopdf applies Landscape after reading custom dimensions. -->
            <field name="page_width">105</field>
            <field name="page_height">148</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">96</field>
        </record>

        <record id="report_gift_card_a6_demo" model="ir.actions.report">
            <field name="name">معاينة كوبون الخصم A6</field>
            <field name="model">loyalty.card</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">pos_gift_card_a6_demo.gift_card_a6_demo_document</field>
            <field name="report_file">pos_gift_card_a6_demo.gift_card_a6_demo_document</field>
            <field name="paperformat_id" ref="pos_gift_card_a6_demo.paperformat_gift_card_a6_landscape_demo"/>
            <field name="binding_model_id" ref="loyalty.model_loyalty_card"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'discount-coupon-a6-%s' % object.code</field>
        </record>

        <!-- Preview report. It renders the very same artwork as the production
             coupon, so the two can never drift apart. -->
        <template id="gift_card_a6_demo_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="loyalty.gift_card_report"/>
                </t>
            </t>
        </template>
    </data>
</odoo>
