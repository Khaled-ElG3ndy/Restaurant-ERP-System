<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_prepaid_expenses" model="ir.ui.view">
        <field name="name">account.move.form.prepaid.expenses</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_prepaid_purchase_document" invisible="1"/>
                <button name="action_open_prepaid_schedule"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        groups="account.group_account_readonly"
                        invisible="(not is_prepaid_purchase_document and move_type != 'in_refund') or not prepaid_schedule_count">
                    <field name="prepaid_schedule_count" widget="statinfo" string="المصروفات المقدمة"/>
                </button>
            </xpath>
            <xpath expr="//header/button[@name='action_post'][last()]" position="after">
                <button name="action_create_prepaid_expense"
                        type="object"
                        string="إنشاء مصروف مقدم"
                        class="btn-primary"
                        groups="account.group_account_invoice"
                        invisible="not can_create_prepaid_expense"/>
                <button name="action_post_due_prepaid_entries"
                        type="object"
                        string="ترحيل الأقساط المستحقة"
                        groups="account.group_account_invoice"
                        invisible="state != 'posted' or (not is_prepaid_purchase_document and move_type != 'in_refund') or not prepaid_schedule_count"/>
            </xpath>
        </field>
    </record>
</odoo>
