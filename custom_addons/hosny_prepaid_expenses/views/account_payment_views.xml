<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_prepaid_expenses" model="ir.ui.view">
        <field name="name">account.payment.form.prepaid.expenses</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_create_prepaid_expense"
                        type="object"
                        string="إنشاء مصروف مقدم"
                        class="btn-primary"
                        groups="account.group_account_invoice"
                        invisible="not can_create_prepaid_expense"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_prepaid_expenses"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        groups="account.group_account_readonly"
                        invisible="not prepaid_schedule_count">
                    <field name="prepaid_schedule_count" widget="statinfo" string="المصروفات المقدمة"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="after">
                <group string="المصروفات المقدمة" invisible="not prepaid_schedule_count">
                    <field name="prepaid_used_amount" string="المبلغ المستخدم" readonly="1"/>
                    <field name="prepaid_available_amount" string="المبلغ المتبقي" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
