<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hosny_purchase_vendor_bill_confirm_form" model="ir.ui.view">
        <field name="name">hosny.purchase.vendor.bill.confirm.form</field>
        <field name="model">hosny.purchase.vendor.bill.confirm</field>
        <field name="arch" type="xml">
            <form string="تأكيد إنشاء فاتورة إضافية">
                <group>
                    <field name="purchase_id" readonly="1"/>
                    <field name="existing_bill_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <p>
                    توجد فواتير مورد مرتبطة بهذا الطلب. سيتم إنشاء فاتورة إضافية فقط للكميات المتبقية القابلة للفوترة.
                </p>
                <footer>
                    <button name="action_confirm_create_bill" type="object" string="تأكيد إنشاء فاتورة إضافية" class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
