<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_list_work_location" model="ir.ui.view">
        <field name="name">hr.attendance.list.hosny.work.location</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="work_location_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="hr_attendance_form_work_location" model="ir.ui.view">
        <field name="name">hr.attendance.form.hosny.work.location</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="work_location_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="hr_attendance_search_work_location" model="ir.ui.view">
        <field name="name">hr.attendance.search.hosny.work.location</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="work_location_id"/>
            </field>
            <search position="inside">
                <filter name="group_work_location"
                        string="Work Location"
                        context="{'group_by': 'work_location_id'}"/>
            </search>
        </field>
    </record>
</odoo>
