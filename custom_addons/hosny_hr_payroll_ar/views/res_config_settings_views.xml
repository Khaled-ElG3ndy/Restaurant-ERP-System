<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hosny_payroll_ar" model="ir.ui.view">
        <field name="name">res.config.settings.form.hosny.payroll.ar</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bi_hr_payroll.res_config_settings_view_form"/>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='bi_hr_payroll']" position="inside">
                <h2>التأمينات الاجتماعية</h2>
                <div class="row mt16 o_settings_container"
                     id="hosny_social_insurance_settings">
                    <div class="col-lg-6 col-12 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="hosny_social_insurance_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="hosny_social_insurance_enabled"/>
                            <div class="text-muted">
                                احتساب حصة الموظف وجهة العمل من الأجر التأميني المحدد في العقد.
                            </div>
                            <div class="content-group mt16"
                                 invisible="not hosny_social_insurance_enabled">
                                <div class="row mb8">
                                    <label for="hosny_social_insurance_employee_rate"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="hosny_social_insurance_employee_rate"
                                           class="oe_inline"/>
                                </div>
                                <div class="row mb8">
                                    <label for="hosny_social_insurance_employer_rate"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="hosny_social_insurance_employer_rate"
                                           class="oe_inline"/>
                                </div>
                                <div class="row mb8">
                                    <label for="hosny_social_insurance_minimum_base"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="hosny_social_insurance_minimum_base"
                                           class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="hosny_social_insurance_maximum_base"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="hosny_social_insurance_maximum_base"
                                           class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
