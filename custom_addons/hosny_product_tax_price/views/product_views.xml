<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_price_before_tax" model="ir.ui.view">
        <field name="name">product.template.form.price.before.tax</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <div name="taxes_div" position="after">
                <field name="price_before_tax" readonly="1" widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </div>
        </field>
    </record>

    <record id="product_product_form_price_before_tax" model="ir.ui.view">
        <field name="name">product.product.form.price.before.tax</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="account.product_product_view_form_normalized_account"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <div name="tax_info" position="after">
                <field name="price_before_tax" readonly="1" widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </div>
        </field>
    </record>
</odoo>
