<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hosny_payroll_account" model="ir.ui.view">
        <field name="name">res.config.settings.form.hosny.payroll.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="bi_hr_payroll.res_config_settings_view_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='bi_hr_payroll']" position="inside">
                <h2>المحاسبة</h2>
                <div class="row mt16 o_settings_container"
                     id="hosny_payroll_account_settings">
                    <div class="col-lg-6 col-12 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="hosny_payroll_journal_id"/>
                            <div class="text-muted">
                                اليومية التي تُرحَّل إليها قيود قسائم الرواتب عند الاعتماد.
                            </div>
                            <div class="content-group mt16">
                                <field name="hosny_payroll_journal_id"
                                       options="{'no_create': True}"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="hosny_payroll_analytic_account_id"/>
                            <div class="text-muted">
                                يُستخدم عندما لا يكون لموقع عمل الموظف حساب تحليلي محدد.
                            </div>
                            <div class="content-group mt16">
                                <field name="hosny_payroll_analytic_account_id"
                                       options="{'no_create': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
