<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- زر التحويل الجزئي -->
    <t t-name="hosny_pos_partial_transfer.PartialTransferButton">
        <button
            class="control-button btn btn-light rounded-4"
            t-att-disabled="this.isDisabled"
            t-on-click="click"
        >
            <i class="fa fa-exchange me-2"/>
            تحويل جزئي
        </button>
    </t>

    <!-- Popup -->
    <t t-name="hosny_pos_partial_transfer.PartialTransferPopup">
        <div class="modal-dialog">
            <div class="popup popup-lg">

                <div class="p-4">
                    <h3 class="mb-3">
                        تحويل جزئي بين الطاولات
                    </h3>

                    <div class="d-flex flex-column gap-3">

                        <t t-foreach="tableSections" t-as="section" t-key="section.id">

                            <div class="border rounded p-3">

                                <div class="fw-bold mb-2">
                                    <t t-esc="section.name"/>
                                </div>

                                <div class="d-flex flex-column gap-2">

                                    <t t-foreach="section.tables" t-as="tableItem" t-key="tableItem.table.id">

                                        <button
                                            class="btn btn-light text-start border"
                                            t-on-click="() => this.setDestinationTable(tableItem.table.id)"
                                        >
                                            <t t-esc="tableItem.name"/>
                                        </button>

                                    </t>

                                </div>

                            </div>

                        </t>

                    </div>
                </div>

                <div class="footer d-flex justify-content-end gap-2 p-3">

                    <button
                        class="btn btn-secondary"
                        t-on-click="() => this.props.close()"
                    >
                        إلغاء
                    </button>

                    <button
                        class="btn btn-primary"
                        t-on-click="confirm"
                    >
                        تحويل
                    </button>

                </div>

            </div>
        </div>
    </t>

</templates>