<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="migration_log_list" model="ir.ui.view">
        <field name="name">hosny.hr.work.location.migration.log.list</field>
        <field name="model">hosny.hr.work.location.migration.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="state == 'unresolved'"
                  decoration-success="state == 'migrated'">
                <field name="employee_id"/>
                <field name="old_value"/>
                <field name="work_location_id"/>
                <field name="state" widget="badge"/>
                <field name="message"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="migration_log_search" model="ir.ui.view">
        <field name="name">hosny.hr.work.location.migration.log.search</field>
        <field name="model">hosny.hr.work.location.migration.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="old_value"/>
                <field name="work_location_id"/>
                <filter name="unresolved"
                        string="Unresolved"
                        domain="[('state', '=', 'unresolved')]"/>
                <filter name="migrated"
                        string="Migrated"
                        domain="[('state', '=', 'migrated')]"/>
                <group>
                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_work_location"
                            string="Work Location"
                            context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="migration_log_action" model="ir.actions.act_window">
        <field name="name">Work Location Migration Report</field>
        <field name="res_model">hosny.hr.work.location.migration.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="migration_log_search"/>
        <field name="context">{'search_default_unresolved': 1}</field>
    </record>

    <menuitem id="migration_log_menu"
              name="Work Location Migration Report"
              parent="hr.menu_config_employee"
              action="migration_log_action"
              sequence="6"
              groups="hr.group_hr_manager"/>
</odoo>
