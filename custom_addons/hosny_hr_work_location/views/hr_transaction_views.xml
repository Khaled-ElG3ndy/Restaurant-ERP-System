    <record id="hr_work_entry_search_work_location" model="ir.ui.view">
        <field name="name">hr.work.entry.search.hosny.work.location</field>
        <field name="model">hr.work.entry</field>
        <field name="inherit_id" ref="hr_work_entry.hr_work_entry_view_search"/>
        <field name="arch" type="xml">
