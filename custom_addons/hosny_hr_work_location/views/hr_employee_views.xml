    <record id="hr_employee_search_work_location" model="ir.ui.view">
        <field name="name">hr.employee.search.hosny.work.location</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="work_location_id"/>
            </field>
            <filter name="group_department" position="after">
                <filter name="group_work_location"
                        string="مكان العمل"
                        context="{'group_by': 'work_location_id'}"/>
            </filter>
        </field>
    </record>

    <record id="hr_employee_pivot_work_location" model="ir.ui.view">
        <field name="name">hr.employee.pivot.hosny.work.location</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_employee_view_pivot"/>
        <field name="arch" type="xml">
            <pivot position="inside">
                <field name="work_location_id" type="row"/>
            </pivot>
        </field>
    </record>
</odoo>
