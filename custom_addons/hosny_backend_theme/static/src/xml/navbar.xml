<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">

    <t
        t-name="hosny_backend_theme.NavBar"
        t-inherit="web.NavBar"
        t-inherit-mode="extension"
    >
        <xpath expr="//nav[contains(@class, 'o_main_navbar')]" position="before">
            <t t-call="hosny_backend_theme.HosnyAppsSidebar" />
        </xpath>
    </t>

    <t
        t-name="hosny_backend_theme.NavBar.AppsMenu"
        t-inherit="web.NavBar.AppsMenu"
        t-inherit-mode="primary"
    >
        <t t-if="this.ui.isSmall">
            <a href="/odoo" class="o_menu_toggle border-0"
                t-att-class="{'hasImage': currentApp?.webIconData}"
                accesskey="h" t-ref="menuApps"
                t-on-click.prevent="_openAppMenuSidebar">
                <t t-call="web.NavBar.AppsMenu.Sidebar"/>
            </a>
        </t>
        <t t-else="">
            <div t-if="!isScopedApp" class="o_navbar_apps_menu">
                <div class="hosny_sidebar_toggle_container d-flex align-items-center">
                    <button
                        class="hosny_sidebar_toggle btn btn-link text-reset p-0 me-2"
                        t-att-title="this.getHosnySidebarToggleTitle()"
                        t-att-aria-label="this.getHosnySidebarToggleTitle()"
                        t-att-aria-expanded="!this.sidebarCollapsed"
                        t-on-click="this.toggleSidebar"
                    >
                        <i t-att-class="this.getHosnySidebarToggleIcon()" />
                    </button>
                </div>
                
                <AppsMenu
                    hotkey="'h'"
                    title="'Home Menu'"
                    class="'o_navbar_apps_menu hosny_home_menu'"
                >
                    <t t-set-slot="toggler">
                        <i class="fa fa-th-large" />
                    </t>

                    <section class="hosny_home_menu__hero">
                        <div
                            class="hosny_home_menu__brandmark"
                            t-att-class="{ 'is-image': this.hasHosnyCompanyLogo() }"
                        >
                            <img
                                t-if="this.hasHosnyCompanyLogo()"
                                t-att-src="this.getHosnyCompanyLogoUrl()"
                                t-att-alt="this.getHosnyCompanyName()"
                            />
                            <span t-else="">
                                <t t-out="this.getHosnyCompanyInitials()" />
                            </span>
                        </div>

                        <div class="hosny_home_menu__hero_copy">
                            <span class="hosny_home_menu__eyebrow">Hosny Control Center</span>
                            <h1>
                                <t t-out="this.getHosnyCompanyName()" />
                            </h1>
                            <p>
                                تجربة تشغيل أكثر احترافية لإدارة المطعم والمبيعات والمخزون
                                من شاشة رئيسية أنيقة وسريعة وواضحة.
                            </p>
                            <div class="hosny_home_menu__hero_meta">
                                <span class="hosny_home_menu__pill">
                                    <i class="fa fa-th-large" />
                                    <t t-out="this.getHosnyAppsCount()" /> تطبيقات
                                </span>
                                <span class="hosny_home_menu__pill">
                                    <i class="fa fa-bolt" />
                                    ابدأ الكتابة للبحث السريع
                                </span>
                                <span class="hosny_home_menu__pill">
                                    <i class="fa fa-calendar" />
                                    <t t-out="this.getHosnyDateLabel()" />
                                </span>
                            </div>
                        </div>
                    </section>

                    <div class="hosny_home_menu__section_header">
                        <span>الأنظمة الرئيسية</span>
                        <small>اختر القسم الذي تريد العمل عليه</small>
                    </div>

                    <DropdownItem
                        t-foreach="this.appMenuService.getAppsMenuItems()"
                        t-as="app"
                        t-key="app.id"
                        class="'o_app hosny_home_menu__app'"
                        dataset="{ menuXmlid: app.xmlid, section: app.id }"
                        onSelected="() => app.action()"
                        parentClosingMode="'none'"
                    >
                        <a t-att-href="app.href" t-on-click.prevent="">
                            <span class="hosny_home_menu__app_icon_wrap">
                                <img
                                    t-if="app.webIconData"
                                    class="mk_app_icon"
                                    t-att-src="app.webIconData"
                                    t-att-alt="app.name"
                                />
                                <img
                                    t-else=""
                                    class="mk_app_icon"
                                    src="/base/static/description/icon.png"
                                    t-att-alt="app.name"
                                />
                            </span>

                            <span class="hosny_home_menu__app_body">
                                <span class="mk_app_name">
                                    <t t-out="app.name" />
                                </span>
                                <span class="hosny_home_menu__app_caption">
                                    دخول سريع إلى هذا القسم
                                </span>
                            </span>

                            <span class="hosny_home_menu__app_arrow">
                                <i class="fa fa-angle-left" />
                            </span>
                        </a>
                    </DropdownItem>
                </AppsMenu>
            </div>
            <div t-else="" class="mx-2"/>
        </t>
    </t>

    <!-- Sidebar Component -->
    <t t-name="hosny_backend_theme.HosnyAppsSidebar">
        <div class="hosny_apps_sidebar" t-att-class="{'hosny_apps_sidebar--collapsed': this.sidebarCollapsed}" data-testid="hosny_apps_sidebar">
        <div class="hosny_apps_sidebar__header d-flex align-items-center justify-content-between">
            <span class="hosny_apps_sidebar__title fw-bold">الأنظمة</span>
            <button
                class="hosny_apps_sidebar__close btn btn-link text-reset p-0"
                t-att-title="this.getHosnySidebarToggleTitle()"
                t-att-aria-label="this.getHosnySidebarToggleTitle()"
                t-att-aria-expanded="!this.sidebarCollapsed"
                t-on-click="this.toggleSidebar"
            >
                <i t-att-class="this.getHosnySidebarToggleIcon()" />
            </button>
        </div>
        <nav class="hosny_apps_sidebar__nav">
            <div class="hosny_apps_sidebar__nav_wrapper">
                <t t-foreach="this.appMenuService.getAppsMenuItems()" t-as="app" t-key="app.id">
                    <button
                        class="hosny_apps_sidebar__app"
                        t-att-title="app.name"
                        t-att-data-app-id="app.id"
                        t-on-click="() => app.action()"
                    >
                        <span class="hosny_apps_sidebar__app_icon">
                            <img
                                t-if="app.webIconData"
                                class="mk_app_icon"
                                t-att-src="app.webIconData"
                                t-att-alt="app.name"
                            />
                            <img
                                t-else=""
                                class="mk_app_icon"
                                src="/base/static/description/icon.png"
                                t-att-alt="app.name"
                            />
                        </span>
                        <span class="hosny_apps_sidebar__app_label" t-esc="app.name" />
                    </button>
                </t>
            </div>
        </nav>
        </div>
    </t>

</templates>
