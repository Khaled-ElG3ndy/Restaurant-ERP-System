<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hosny_purchase_price_history_wizard_form" model="ir.ui.view">
        <field name="name">hosny.purchase.price.history.wizard.form</field>
        <field name="model">hosny.purchase.price.history.wizard</field>
        <field name="arch" type="xml">
            <form string="آخر أسعار الشراء" class="o_hosny_price_history_modal">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="has_history" invisible="1"/>
                    <group class="o_hosny_price_history_header">
                        <field name="product_id" string="المنتج" readonly="1" options="{'no_open': True}"/>
                    </group>
                    <div class="o_hosny_price_history_summary">
                        <div class="o_hosny_price_history_stat">
                            <span>آخر سعر</span>
                            <field name="last_price" widget="monetary" options="{'currency_field': 'currency_id'}" nolabel="1" readonly="1"/>
                        </div>
                        <div class="o_hosny_price_history_stat">
                            <span>أقل سعر</span>
                            <field name="lowest_price" widget="monetary" options="{'currency_field': 'currency_id'}" nolabel="1" readonly="1"/>
                        </div>
                        <div class="o_hosny_price_history_stat">
                            <span>أعلى سعر</span>
                            <field name="highest_price" widget="monetary" options="{'currency_field': 'currency_id'}" nolabel="1" readonly="1"/>
                        </div>
                        <div class="o_hosny_price_history_stat">
                            <span>متوسط السعر</span>
                            <field name="average_price" widget="monetary" options="{'currency_field': 'currency_id'}" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                    <div class="alert alert-info text-center my-3" invisible="has_history">
                        <field name="empty_message" nolabel="1" readonly="1"/>
                    </div>
                    <field name="line_ids" nolabel="1" readonly="1" invisible="not has_history">
                        <list create="0" delete="0" edit="0" class="o_hosny_price_history_lines">
                            <field name="purchase_date" string="تاريخ الشراء"/>
                            <field name="vendor_id" string="المورد" options="{'no_open': True}"/>
                            <field name="branch_id" string="الفرع" options="{'no_open': True}"/>
                            <field name="quantity" string="الكمية"/>
                            <field name="product_uom_id" string="وحدة القياس" options="{'no_open': True}"/>
                            <field name="price_unit" string="سعر الوحدة" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="tax_display" string="الضرائب"/>
                            <field name="total_amount" string="إجمالي مبلغ البند" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="source_reference" string="مرجع أمر الشراء / فاتورة المورد"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                        <form string="سجل الأسعار">
                            <sheet>
                                <field name="currency_id" invisible="1"/>
                                <group>
                                    <field name="order_line_id" string="بند أمر الشراء" readonly="1" options="{'no_open': True}"/>
                                    <field name="purchase_date" string="تاريخ الشراء" readonly="1"/>
                                    <field name="vendor_id" string="المورد" readonly="1" options="{'no_open': True}"/>
                                    <field name="branch_id" string="الفرع" readonly="1" options="{'no_open': True}"/>
                                    <field name="quantity" string="الكمية" readonly="1"/>
                                    <field name="product_uom_id" string="وحدة القياس" readonly="1" options="{'no_open': True}"/>
                                    <field name="price_unit" string="سعر الوحدة" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="tax_display" string="الضرائب" readonly="1"/>
                                    <field name="total_amount" string="إجمالي مبلغ البند" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="source_reference" string="مرجع أمر الشراء / فاتورة المورد" readonly="1"/>
                                </group>
                            </sheet>
                            <footer>
                                <button string="إغلاق" special="cancel" class="btn-primary"/>
                            </footer>
                        </form>
                    </field>
                </sheet>
                <footer>
                    <button string="إغلاق" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
