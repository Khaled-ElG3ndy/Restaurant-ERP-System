<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hosny_purchase_packaging_template_list_view" model="ir.ui.view">
        <field name="name">hosny.purchase.packaging.template.list</field>
        <field name="model">hosny.purchase.packaging.template</field>
        <field name="arch" type="xml">
            <list string="Purchase Packaging" default_order="sequence, name, id" open_form_view="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="summary" readonly="1"/>
                <field name="final_base_qty" readonly="1"/>
                <field name="base_uom_id" readonly="1" options="{'no_open': True}"/>
                <field name="active" string="Enabled" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="details_button"
                       string="Packaging Details"
                       widget="hosny_packaging_template_details_button"
                       groups="purchase.group_purchase_manager"/>
            </list>
        </field>
    </record>

    <record id="hosny_purchase_packaging_template_form_view" model="ir.ui.view">
        <field name="name">hosny.purchase.packaging.template.form</field>
        <field name="model">hosny.purchase.packaging.template</field>
        <field name="arch" type="xml">
            <form string="Purchase Packaging Template"
                  class="o_hosny_packaging_dialog_form o_hosny_packaging_template_dialog_form">
                <sheet class="o_hosny_packaging_dialog o_hosny_packaging_template_dialog">
                    <field name="allowed_content_uom_ids" invisible="1"/>
                    <field name="level_count" invisible="1"/>
                    <field name="sequence" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="summary" invisible="1"/>

                    <div class="o_hosny_packaging_header hosny-packaging-dialog-header">
                        <div class="o_hosny_header_meta" dir="ltr">
                            <div class="o_hosny_header_unit" dir="rtl">
                                <span class="text-muted">Base Unit</span>
                                <field name="base_uom_id" nolabel="1" readonly="1" options="{'no_open': True}"/>
                            </div>
                            <div class="o_hosny_header_product" dir="rtl">
                                <span class="text-muted">Product</span>
                                <field name="product_tmpl_id" nolabel="1" readonly="id"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_hosny_packaging_body" dir="ltr">
                        <aside class="o_hosny_packaging_summary summary_panel" dir="rtl">
                            <h3>Packaging Template Summary</h3>
                            <field name="level_count"
                                   nolabel="1"
                                   readonly="1"
                                   widget="hosny_packaging_template_calculation_summary"
                                   options="{'mode': 'template'}"/>
                        </aside>

                        <div class="o_hosny_packaging_main main_form_panel" dir="rtl">
                            <section class="o_hosny_packaging_card">
                                <h3 data-section-number="1">Template Information</h3>
                                <group col="4" class="o_hosny_rtl_group">
                                    <field name="name" required="1"/>
                                    <field name="main_packaging_type_id"
                                           required="1"
                                           domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                                           context="{'default_company_id': company_id}"/>
                                    <field name="active" string="Enabled" widget="boolean_toggle"/>
                                </group>
                            </section>

                            <section class="o_hosny_packaging_card o_hosny_components_card">
                                <h3 data-section-number="2">Packaging Components (Largest to Smallest)</h3>
                                <field name="line_ids"
                                       nolabel="1"
                                       class="o_hosny_packaging_levels"
                                       widget="hosny_packaging_sentence_levels"
                                       context="{'default_company_id': company_id, 'default_final_uom_id': base_uom_id}">
                                    <list editable="bottom" create="0" delete="1" string="Packaging Levels">
                                        <field name="company_id" column_invisible="True"/>
                                        <field name="is_final_level" column_invisible="True"/>
                                        <field name="base_uom_factor" column_invisible="True" readonly="1"/>
                                        <field name="content_type" column_invisible="True"/>
                                        <field name="quantity" string="Contains" options="{'hide_trailing_zeros': True}"/>
                                        <field name="packaging_type_id"
                                               string="Packaging Type"
                                               invisible="content_type != 'packaging'"
                                               required="content_type == 'packaging'"
                                               domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                                               context="{'default_company_id': parent.company_id}"/>
                                        <field name="final_uom_id"
                                               string="Final Content"
                                               invisible="content_type != 'base_uom'"
                                               required="content_type == 'base_uom'"
                                               domain="[('id', 'in', parent.allowed_content_uom_ids)]"
                                               options="{'no_create': True, 'no_open': True}"/>
                                        <field name="sequence" widget="handle" column_invisible="True"/>
                                    </list>
                                </field>
                            </section>

                            <section class="o_hosny_packaging_card o_hosny_template_note_card">
                                <div class="alert alert-success mb-0" role="status">
                                    Editing purchase-order data loaded from this template will not change the original template.
                                </div>
                            </section>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_template_form_purchase_packaging_templates" model="ir.ui.view">
        <field name="name">product.template.form.purchase.packaging.templates</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="before">
                <page string="Purchase Packaging" name="hosny_purchase_packaging_templates">
                    <field name="hosny_purchase_packaging_template_ids"
                           context="{'default_product_tmpl_id': id, 'default_company_id': company_id}"
                           mode="list"
                           class="o_hosny_purchase_packaging_template_lines"
                           nolabel="1"/>
                    <div class="text-muted mt-2">
                        Save reusable packaging structures here. Purchase quantities and actual prices are entered on each purchase order.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_purchase_packaging_templates" model="ir.ui.view">
        <field name="name">product.product.form.purchase.packaging.templates</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <!--
            The template view above already extends the common product form,
            which is also the parent of product.product_normal_form_view.
            Keeping a second variant view therefore renders this tab twice
            when a product is opened from a POS order.
        -->
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="before">
                <page string="Purchase Packaging" name="hosny_purchase_packaging_templates_variant">
                    <field name="hosny_purchase_packaging_template_ids"
                           context="{'default_product_tmpl_id': product_tmpl_id, 'default_company_id': company_id}"
                           mode="list"
                           class="o_hosny_purchase_packaging_template_lines"
                           nolabel="1"/>
                    <div class="text-muted mt-2">
                        These templates belong to the product template and are shared by all variants without duplicate records.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
